# Discord bot token — from https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=your_bot_token_here

# Application (client) ID — from https://discord.com/developers/applications → General Information
CLIENT_ID=your_application_id_here

# AES-256 key (base64, 32 bytes) used to encrypt sessions/*/sessions.json at rest.
# Generate with: openssl rand -base64 32
SESSIONS_ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here